          "rawQuery": true,
          "rawSql": "SELECT\n  s.gebaude     AS \"Gebäude\",\n  s.type         AS \"Müllart\",       -- Müllart\n  SUM(f.new_fill_in) AS value     -- Gesamtmenge\nFROM sensor_data_uni s\nJOIN sensor_fill_level f \n  ON s.sensor_id = f.sensor_id\n-- OPTIONAL: Zeitraum begrenzen, z.B. mit created_at\n-- WHERE f.created_at::date BETWEEN '2025-01-01' AND '2025-01-31'\nWHERE $__timeFilter(f.created_at)\nGROUP BY\n  s.gebaude,\n  s.type\nORDER BY\n  s.gebaude,\n  s.type;\n",
