        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf0g6y32klfy8f"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sensor_simulation AS (\n  SELECT * FROM (\n    VALUES\n      ('Simu001', 1),\n      ('Simu002', 1),\n      ('Simu003', 1),\n      ('Simu004', 2),\n      ('Simu005', 2),\n      ('Simu006', 2),\n      ('Simu007', 2),\n      ('Simu008', 3),\n      ('Simu009', 3),\n      ('Simu010', 3)\n  ) AS t(sensor_id, simulation_number)\n),\n\nsim AS (\n  SELECT\n    d.sensor_id,\n    d.simulation_number,\n    (d.ts AT TIME ZONE 'Europe/Berlin')::date AS day,\n    d.new_fill_in,\n    MIN((d.ts AT TIME ZONE 'Europe/Berlin')::date)\n      OVER (PARTITION BY d.sensor_id, d.simulation_number) AS start_date\n  FROM sensor_daily_delta d\n  JOIN sensor_simulation ss\n    ON d.sensor_id = ss.sensor_id\n   AND d.simulation_number = ss.simulation_number\n  WHERE d.simulation = TRUE\n    AND $__timeFilter(d.ts)          -- 🔑 Grafana-Zeitraum\n),\n\nbase AS (\n  SELECT\n    *,\n    (day - start_date)::int AS days_since_start,\n    (((EXTRACT(dow FROM day)::int + 6) % 7) + 1) AS dow_user\n  FROM sim\n),\n\n-- erster Montag je Sensor\nfirst_monday AS (\n  SELECT\n    sensor_id,\n    simulation_number,\n    MIN(days_since_start) AS first_pickup_day\n  FROM base\n  WHERE dow_user = 1\n  GROUP BY sensor_id, simulation_number\n),\n\n-- Abholtage markieren (Montag, alle 7 Tage)\nmarked AS (\n  SELECT\n    b.*,\n    fm.first_pickup_day,\n    CASE\n      WHEN b.days_since_start > fm.first_pickup_day\n       AND (b.days_since_start - fm.first_pickup_day) % 7 = 0\n      THEN 1\n      ELSE 0\n    END AS pickup_flag\n  FROM base b\n  JOIN first_monday fm\n    ON b.sensor_id = fm.sensor_id\n   AND b.simulation_number = fm.simulation_number\n),\n\n-- Zyklen bilden\ngrp_calc AS (\n  SELECT\n    *,\n    SUM(pickup_flag) OVER (\n      PARTITION BY sensor_id, simulation_number\n      ORDER BY day\n      ROWS UNBOUNDED PRECEDING\n    ) AS grp\n  FROM marked\n),\n\n-- Wochenfüllstand je Zyklus\nweekly_fill AS (\n  SELECT\n    sensor_id,\n    simulation_number,\n    grp,\n    SUM(new_fill_in) AS fill_before_pickup\n  FROM grp_calc\n  GROUP BY sensor_id, simulation_number, grp\n)\n\n-- 🔑 Ergebnis: Ø Füllstand bei Abholung im gewählten Zeitraum\nSELECT\n  sensor_id,\n  --simulation_number,\n  ROUND(AVG(fill_before_pickup), 2) AS avg_fill_at_pickup\n  --COUNT(*)                          AS pickup_count\nFROM weekly_fill\nWHERE grp > 0\nGROUP BY sensor_id, simulation_number\nORDER BY sensor_id;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
