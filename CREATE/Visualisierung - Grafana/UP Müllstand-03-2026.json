          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    CONCAT(\n        FLOOR(EXTRACT(EPOCH FROM (a.estimated_full_time - NOW())) / 86400), ' Tage, ',\n        FLOOR(MOD(EXTRACT(EPOCH FROM (a.estimated_full_time - NOW())) / 3600, 24)), ' Stunden'\n    ) AS \"Zeit bis Voll\",\n    --s.sensor_id AS \"ID\",\n    (s.gebaude || ' - ' || s.standortbeschreibung) AS \"Standort\"\n    --a.estimated_full_time AS \"Prognose\"\nFROM sensor_data_uni s\nJOIN sensor_avg_fill_rate a ON s.sensor_id = a.sensor_id\nORDER BY \"Zeit bis Voll\"ASC;\n",
